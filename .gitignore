**/*_gitignore*

# macOS
.DS_Store

# Node
node_modules/
pnpm-lock.yaml

### Yarn. Upstream's pattern: deny the directory's contents, then re-admit what is source.
### Must be `.yarn/*`, not `.yarn/`: git cannot re-include a path whose parent directory is excluded.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build / generated
dist/
build/
logs/
tsconfig.tsbuildinfo
eslint.config.js

# Editor (.vscode is tracked as shared config; .idea is per-developer)
.idea/
VSCProject.code-workspace

# Scaffold
.env
.scaffold/

