{
  "name": "markdb-connect",
  "version": "0.2.3",
  "description": "Zotero plugin that links your Markdown database to Zotero.",
  "author": "Dae Houlihan <dev@daeh.info> (https://daeh.info)",
  "license": "MIT",
  "type": "module",
  "config": {
    "addonName": "MarkDB-Connect",
    "addonID": "daeda@mit.edu",
    "addonRef": "mdbc",
    "addonInstance": "MDBC",
    "prefsPrefix": "extensions.zotero.mdbc",
    "updateJSON": "https://raw.githubusercontent.com/daeh/zotero-markdb-connect/main/update.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daeh/zotero-markdb-connect.git"
  },
  "bugs": {
    "url": "https://github.com/daeh/zotero-markdb-connect/issues"
  },
  "homepage": "https://github.com/daeh/zotero-markdb-connect#readme",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:unit && npm run typecheck:zotero && npm run typecheck:repo",
    "typecheck:app": "tsc --noEmit",
    "typecheck:unit": "tsc --noEmit -p tests/unit/tsconfig.json",
    "typecheck:zotero": "tsc --noEmit -p tests/zotero/tsconfig.json",
    "typecheck:repo": "tsc --noEmit -p tsconfig.repo.json",
    "lint": "npm run format && eslint --fix .",
    "lint-dry": "npm run format:check && npm run lint:check",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --config prettier.config.mjs --write .",
    "format:check": "prettier --config prettier.config.mjs --check .",
    "update-deps": "set -e; npm outdated --depth=0 || true; npm update --save; npm outdated --depth=0 || true",
    "release": "zotero-plugin release",
    "test": "node --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --test 'tests/unit/**/*.test.ts'",
    "test:zotero": "zotero-plugin test --no-watch",
    "test:zotero:watch": "zotero-plugin test"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.0",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "^26.1.1",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "eslint": "~10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "mocha": "11.7.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "zotero-plugin-scaffold": "^0.8.7",
    "zotero-types": "^4.1.2"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
