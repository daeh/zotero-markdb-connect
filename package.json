{
  "name": "markdb-connect",
  "version": "0.2.5",
  "description": "Zotero plugin that links your Markdown database to Zotero.",
  "author": "Dae Houlihan <dev@daeh.info> (https://daeh.info)",
  "license": "MIT",
  "type": "module",
  "config": {
    "addonName": "MarkDB-Connect",
    "addonID": "daeda@mit.edu",
    "addonRef": "mdbc",
    "addonInstance": "MDBC",
    "prefsPrefix": "extensions.zotero.mdbc",
    "updateJSON": "https://raw.githubusercontent.com/daeh/zotero-markdb-connect/main/update.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daeh/zotero-markdb-connect.git"
  },
  "bugs": {
    "url": "https://github.com/daeh/zotero-markdb-connect/issues"
  },
  "homepage": "https://github.com/daeh/zotero-markdb-connect#readme",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "typecheck": "yarn typecheck:app && yarn typecheck:unit && yarn typecheck:zotero && yarn typecheck:repo",
    "typecheck:app": "tsc --noEmit",
    "typecheck:unit": "tsc --noEmit -p tests/unit/tsconfig.json",
    "typecheck:zotero": "tsc --noEmit -p tests/zotero/tsconfig.json",
    "typecheck:repo": "tsc --noEmit -p tsconfig.repo.json",
    "lint": "yarn format && eslint --fix .",
    "lint-dry": "yarn format:check && yarn lint:check",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --config prettier.config.mjs --write .",
    "format:check": "prettier --config prettier.config.mjs --check .",
    "update-deps": "yarn set version stable && yarn upgrade-interactive && yarn up --recursive '**'",
    "scaffold:release": "zotero-plugin release",
    "test": "node --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --test 'tests/unit/**/*.test.ts'",
    "test:zotero": "zotero-plugin test --no-watch",
    "test:zotero:watch": "zotero-plugin test",
    "release:build": "yarn build && yarn lint-dry"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "mocha": "12.0.3",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.3"
  },
  "resolutions": {
    "epubjs": "npm:^0.3.93",
    "pdfjs-dist": "npm:^6.5.438"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
