{
  "extends": "zotero-types/entries/sandbox/",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "lib": ["ES2023", "ES2025.RegExp", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    // Legacy decorators require assignment semantics for class fields.
    "useDefineForClassFields": false,
    "types": ["zotero-types"],

    "experimentalDecorators": true,
    "resolveJsonModule": true,
    // Prevent no-emit type checks from writing tsconfig.tsbuildinfo.
    "composite": false,
    "incremental": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Bundled Zotero, DOM, React, and EPUB declarations conflict.
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,

    "noUncheckedSideEffectImports": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "typings", "package.json", "node_modules/zotero-types"],
  "exclude": ["build", "addon", "**/*-lintignore*", "**/*_lintignore*"]
}
