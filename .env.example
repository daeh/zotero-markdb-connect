# Copy this file to `.env` and set paths for your development installation.

# Zotero executable. On macOS this is usually:
# /Applications/Zotero.app/Contents/MacOS/zotero
# Prefer a Zotero copy reserved for development: launching an installation that has a downloaded
# update staged applies that update (and may ask for an administrator password) before Zotero starts.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero

# Dedicated Zotero profile used for plugin development.
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/development-profile

# Optional Zotero data directory. Leave empty to use the profile default.
ZOTERO_PLUGIN_DATA_DIR=

# Command zotero-plugin-scaffold runs after stopping the Zotero it started (on Ctrl-C and when the
# dev server exits). Left empty, the scaffold falls back to `kill -9 $(ps -x | grep zotero)` on macOS
# and `pkill -9 zotero` on Linux, which kills every process whose command line mentions "zotero",
# including a Zotero you are using. `true` makes the fallback a no-op.
ZOTERO_PLUGIN_KILL_COMMAND=true
