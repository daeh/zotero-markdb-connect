# Copy this file to `.env` and set paths for your development installation.

# Zotero executable. On macOS this is usually:
# /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero

# Dedicated Zotero profile used for plugin development.
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/development-profile

# Optional Zotero data directory. Leave empty to use the profile default.
ZOTERO_PLUGIN_DATA_DIR=

# Optional platform-specific command if scaffold cannot stop Zotero itself.
ZOTERO_PLUGIN_KILL_COMMAND=
