{
  "description": "Version comparisons asserted by both the release tooling's port of Mozilla's comparator (scripts/releaselib/mozilla_version.py) and, inside Zotero, the real Services.vc. expected is the sign of compare(a, b).",
  "comparisons": [
    { "a": "1.0pre1", "b": "1.0pre2", "expected": -1 },
    { "a": "1.0pre2", "b": "1.0", "expected": -1 },
    { "a": "1.0", "b": "1.0.0", "expected": 0 },
    { "a": "1.0.0", "b": "1.0.0.0", "expected": 0 },
    { "a": "1", "b": "1.0", "expected": 0 },
    { "a": "1.0.0.0", "b": "1.1pre", "expected": -1 },
    { "a": "1.1pre", "b": "1.1pre0", "expected": 0 },
    { "a": "1.1pre0", "b": "1.0+", "expected": 0 },
    { "a": "1.0+", "b": "1.1pre1a", "expected": -1 },
    { "a": "1.1pre1a", "b": "1.1pre1", "expected": -1 },
    { "a": "1.1pre1", "b": "1.1pre10a", "expected": -1 },
    { "a": "1.1pre10a", "b": "1.1pre10", "expected": -1 },
    { "a": "1.1pre10", "b": "1.1", "expected": -1 },
    { "a": "1.1", "b": "1.1.0.1", "expected": -1 },
    { "a": "1.1.0.1", "b": "1.1.1", "expected": -1 },
    { "a": "1.1.1", "b": "1.1.*", "expected": -1 },
    { "a": "1.1.*", "b": "1.*", "expected": -1 },
    { "a": "1.*", "b": "2.0", "expected": -1 },
    { "a": "1.-1", "b": "1", "expected": -1 },
    { "a": "1.2147483648", "b": "1.0", "expected": 0 },

    { "a": "9.0.6", "b": "9.999", "expected": -1 },
    { "a": "9.999", "b": "9.1000", "expected": -1 },
    { "a": "9.1000", "b": "10.0", "expected": -1 },
    { "a": "10.0", "b": "9.999", "expected": 1 },
    { "a": "10.0", "b": "9.*", "expected": 1 },
    { "a": "10.0", "b": "10.*", "expected": -1 },
    { "a": "10.99", "b": "10.*", "expected": -1 },
    { "a": "10.0.1", "b": "10.*", "expected": -1 },
    { "a": "10.*", "b": "11.0", "expected": -1 },
    { "a": "10.999", "b": "11.0", "expected": -1 },
    { "a": "10.1000", "b": "11.0", "expected": -1 },
    { "a": "11.0", "b": "11.1", "expected": -1 },
    { "a": "10.0", "b": "10.0", "expected": 0 },
    { "a": "11.0b1", "b": "11.0", "expected": -1 },

    { "a": "0.2.4", "b": "0.2.5", "expected": -1 },
    { "a": "0.2.10", "b": "0.2.9", "expected": 1 },
    { "a": "0.3.0-alpha.1", "b": "0.3.0-alpha.2", "expected": -1 },
    { "a": "0.3.0-alpha.2", "b": "0.3.0-beta.1", "expected": -1 },
    { "a": "0.3.0-beta.1", "b": "0.3.0-beta.2", "expected": -1 },
    { "a": "0.3.0-beta.9", "b": "0.3.0-beta.10", "expected": -1 },
    { "a": "0.3.0-beta.2", "b": "0.3.0-rc.1", "expected": -1 },
    { "a": "0.3.0-rc.1", "b": "0.3.0", "expected": -1 },
    { "a": "0.2.9", "b": "0.3.0-alpha.1", "expected": -1 },
    { "a": "0.3.0", "b": "0.3.1-alpha.1", "expected": -1 },
    { "a": "0.3.0-beta9", "b": "0.3.0-beta10", "expected": 1 },

    { "a": "0.0.13alpha", "b": "0.0.13", "expected": -1 },
    { "a": "0.0.13", "b": "0.0.14a", "expected": -1 },
    { "a": "0.0.14a", "b": "0.0.14", "expected": -1 },
    { "a": "0.0.15a", "b": "0.0.16", "expected": -1 },
    { "a": "0.0.17a", "b": "0.0.18a", "expected": -1 },
    { "a": "0.0.19a", "b": "0.0.19b", "expected": -1 },
    { "a": "0.0.19b", "b": "0.0.19", "expected": -1 },
    { "a": "0.0.27", "b": "0.1.8", "expected": -1 }
  ]
}
